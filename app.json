{
  "expo": {
    "name": "À Demain",
    "slug": "a-demain",
    "version": "1.0.11",
    "platforms": [
      "ios",
      "android"
    ],
    "orientation": "portrait",
    "icon": "./assets/Logo_A_demain.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/Logo_A_demain.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agenorhouessou.ademain",
      "infoPlist": {
        "NSCalendarsUsageDescription": "L'application utilise votre calendrier uniquement pour planifier des rappels.",
        "NSUserTrackingUsageDescription": "Cette app ne suit pas les utilisateurs. Aucune donnée n'est collectée."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo_A_demain.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.agenorhouessou.ademain"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "c262e53f-d293-4e81-b54f-e44fd09463c0"
      }
    },
    "owner": "agenorhouessou",
    "runtimeVersion": "1.0.11",
    "updates": {
      "url": "https://u.expo.dev/c262e53f-d293-4e81-b54f-e44fd09463c0"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 35
          }
        }
      ]
    ]
  }
}
